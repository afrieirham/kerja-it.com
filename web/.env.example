DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kerja_it"
CRON_API_KEY=""
# Optional — sponsored jobs from Careerjet (https://www.careerjet.com/partners/api)
CAREERJET_API_KEY=""
# Optional — your whitelisted public ip, enables sponsored jobs in local dev
CAREERJET_DEV_IP=""
# Optional — daily digest to a Telegram channel (bot must be a channel admin)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
# Optional — private chat for moderation alerts from /post-a-job (the bot can
# only message chats that started it or groups it belongs to)
TELEGRAM_ADMIN_CHAT_ID=""
# Required — better-auth session signing (openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Optional — inferred from the request when unset; set in production
BETTER_AUTH_URL="http://localhost:5173"
# Optional — sign-in providers; a provider enables only when BOTH vars are set
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Optional — comma-separated emails allowed into /admin
ADMIN_EMAILS=""
VITE_APP_URL="http://localhost:5173"
